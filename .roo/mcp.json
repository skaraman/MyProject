{
	"mcpServers": {
		"sequentialthinking": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-sequential-thinking"
			],
			"alwaysAllow": [
				"sequentialthinking"
			],
			"timeout": 15,
			"disabled": true
		},
		"memory": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-memory"
			],
			"alwaysAllow": [
				"create_entities",
				"create_relations",
				"add_observations",
				"delete_entities",
				"delete_observations",
				"delete_relations",
				"read_graph",
				"search_nodes",
				"open_nodes"
			],
			"timeout": 15,
			"disabled": true
		},
		"augment-context-engine": {
			"command": "auggie",
			"args": [
				"--mcp",
				"--mcp-auto-workspace"
			],
			"alwaysAllow": [
				"codebase-retrieval"
			],
			"timeout": 15,
			"disabled": true
		}
	}
}